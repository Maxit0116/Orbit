.home-screen {
  padding-top: 36rpx;
}

.topline {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: var(--green-deep);
  color: var(--mint);
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 700;
}

.brand-name {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.mode-pill {
  margin-left: auto;
  padding: 10rpx 14rpx;
  border: 1rpx solid #cfe3d5;
  border-radius: 999rpx;
  color: var(--green);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-top: 54rpx;
  padding: 54rpx 38rpx 42rpx;
  border-radius: 34rpx;
  background: var(--green-deep);
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(23, 76, 55, 0.2);
}

.hero::after {
  position: absolute;
  right: -96rpx;
  bottom: -142rpx;
  width: 320rpx;
  height: 320rpx;
  border: 1rpx solid rgba(217, 243, 226, 0.25);
  border-radius: 50%;
  box-shadow: 0 0 0 26rpx rgba(217, 243, 226, 0.06), 0 0 0 52rpx rgba(217, 243, 226, 0.04);
  content: "";
}

.hero .eyebrow {
  color: var(--mint);
}

.hero-title {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 570rpx;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.7;
}

.hero-button {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  background: #fff;
  color: var(--green-deep);
  box-shadow: none;
}

.button-arrow {
  margin-left: 16rpx;
  font-size: 34rpx;
  line-height: 1;
}

.principle-row {
  display: flex;
  align-items: center;
  margin: 38rpx 6rpx 0;
}

.principle {
  flex: 1;
}

.principle-number {
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 26rpx;
  font-weight: 700;
}

.principle-label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.principle-line {
  width: 1rpx;
  height: 46rpx;
  margin: 0 18rpx;
  background: var(--line);
}

.section-caption {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.workspace-card {
  padding: 30rpx;
}

.workspace-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.space-icon,
.example-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--mint);
  color: var(--green);
  font-size: 28rpx;
  font-weight: 800;
}

.workspace-card-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.workspace-card-goal {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-track {
  height: 12rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf2ed;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--orange);
}

.workspace-card-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.workspace-link {
  color: var(--green);
  font-weight: 700;
}

.examples-heading {
  margin-top: 54rpx;
}

.example-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.example-card {
  position: relative;
  min-height: 220rpx;
  padding: 22rpx;
  text-align: left;
}

.example-icon {
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
}

.example-icon.warm {
  background: var(--orange-soft);
  color: #ad6127;
}

.example-icon.blue {
  background: #e2eff5;
  color: #37687b;
}

.example-icon.purple {
  background: #eee8fa;
  color: var(--purple);
}

.example-title {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.example-copy {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.example-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  color: var(--green);
  font-size: 28rpx;
}

.workspace-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.empty-card {
  margin-bottom: 28rpx;
  padding: 28rpx;
}
